# Copy to .env and replace all passwords with unique local values. Never commit .env.
POSTGRES_USER=local_app_user
POSTGRES_PASS=REPLACE_WITH_A_LONG_RANDOM_LOCAL_PASSWORD
POSTGRES_DB_NAME=requests_db
KC_ADMIN_USER=local_admin
KC_ADMIN_PASS=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD
# Vault token is created during local Vault initialization and exported only for the app.
# VAULT_TOKEN=SET_ONLY_IN_YOUR_LOCAL_ENVIRONMENT
